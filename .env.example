# Settings for running PIC natively (uv run fastapi dev / uv run pic-worker / alembic).
# Copy to .env. The defaults below work with `docker compose up -d db` and local storage.
# Note: the Docker Compose containers do NOT read this file; their settings are in the
# x-pic-env block of docker-compose.yml.

# Database (SQLAlchemy async URL). The Compose database:
PIC_DATABASE_URL=postgresql+asyncpg://pic:pic_local@localhost:5432/pic?sslmode=disable
# Plain PostgreSQL URL for pg_dump / psql (used by `make backup-db` / `make restore-db`)
PIC_POSTGRES_URL=postgresql://pic:pic_local@localhost:5432/pic
# Managed Postgres example (Neon, Supabase, ...):
# PIC_DATABASE_URL=postgresql+asyncpg://user:password@host/pic?sslmode=verify-full

# Runtime environment: development | staging | production | test
# production refuses to start with the local storage backend.
PIC_ENV=development

# Storage: local | s3 | gcs
PIC_STORAGE_BACKEND=local
# same folder Compose mounts, so native and Docker processes share it
PIC_LOCAL_STORAGE_PATH=./data
PIC_LOCAL_STORAGE_BASE_URL=http://localhost:8000/files

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO) when PIC_STORAGE_BACKEND=s3
# PIC_S3_BUCKET=pic-images
# empty for AWS S3
# PIC_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# PIC_S3_ACCESS_KEY_ID=
# PIC_S3_SECRET_ACCESS_KEY=

# Google Cloud Storage when PIC_STORAGE_BACKEND=gcs
# PIC_GCS_BUCKET=
# PIC_GCS_PROJECT_ID=
# service account JSON as a string
# PIC_GCS_CREDENTIALS_JSON=

# Where jobs run: local (pic-worker process, default) or modal
PIC_WORKER_BACKEND=local

# Auth: set a long random PIC_API_KEY for anything reachable by others.
# It protects the JSON API (X-API-Key header) and the web UI (login page).
PIC_API_KEY=
# explicit opt-in to no auth; remove when PIC_API_KEY is set
PIC_AUTH_DISABLED=true

# Uploads (web UI folder upload and POST /api/v1/images/upload)
PIC_MAX_UPLOAD_SIZE_MB=20

# Embedding
PIC_DINOV2_MODEL=facebook/dinov2-base
PIC_EMBEDDING_BATCH_SIZE=32

# Clustering (defaults suit most catalogs)
# PIC_L1_MIN_CLUSTER_SIZE=2
# PIC_L1_CLUSTER_SELECTION_EPSILON=0.10
# PIC_L2_MIN_CLUSTER_SIZE=5
# PIC_L2_MIN_SAMPLES=3

# Google Drive sync (optional; empty = disabled). Needed by both the API and the worker.
# service account JSON as a string (not a file path)
PIC_GDRIVE_SERVICE_ACCOUNT_JSON=
# from the folder URL: drive.google.com/drive/folders/{THIS_PART}
PIC_GDRIVE_FOLDER_ID=
# drive.readonly if files should not move to processed/
# PIC_GDRIVE_SCOPES=["https://www.googleapis.com/auth/drive"]
